<!-- Lake connection for s3() / deltaLake(). Credentials come from the container env. -->
<clickhouse>
    <named_collections>
        <lake_s3>
            <url>http://seaweedfs:8333/lake/</url>
            <access_key_id from_env="S3_ACCESS_KEY"/>
            <secret_access_key from_env="S3_SECRET_KEY"/>
        </lake_s3>
    </named_collections>
</clickhouse>

# Copy to .env and fill in. Never commit .env.

# Object store (SeaweedFS, S3 API)
S3_PORT=18333
SEAWEED_FILER_PORT=18888
SEAWEED_MASTER_PORT=19333
S3_ENDPOINT=http://localhost:18333
S3_ACCESS_KEY=lichess
S3_SECRET_KEY=change-me
LAKE_BUCKET=lake

# ClickHouse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me

# Postgres (SQLMesh state)
POSTGRES_USER=sqlmesh
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sqlmesh_state

# Alerts
SLACK_WEBHOOK_URL=

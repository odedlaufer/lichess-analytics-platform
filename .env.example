# Copy to .env and fill in. Never commit .env.

# Local working directory for downloads and chunks (gitignored)
DATA_DIR=data

# Object store (SeaweedFS, S3 API)
S3_PORT=28333
SEAWEED_FILER_PORT=28888
SEAWEED_MASTER_PORT=29333
S3_ENDPOINT=http://localhost:28333
S3_ACCESS_KEY=lichess
S3_SECRET_KEY=change-me
LAKE_BUCKET=lake

# Spark (laptop profile; see ADR-002 for the memory budget)
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2560m
SPARK_MASTER_UI_PORT=28080
SPARK_WORKER1_UI_PORT=28081
SPARK_WORKER2_UI_PORT=28082
SPARK_HISTORY_UI_PORT=28180

# Kafka (KRaft, single node). Cluster id is a fixed base64 UUID, not a secret.
KAFKA_CLUSTER_ID=3pg4Cbe3R1-CaYjjRgubWA
KAFKA_EXTERNAL_PORT=29092
KAFKA_BOOTSTRAP=localhost:29092

# ClickHouse (user name must match clickhouse/users.d/lichess.xml)
CLICKHOUSE_USER=lichess
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_HTTP_PORT=28123
CLICKHOUSE_NATIVE_PORT=29000
CLICKHOUSE_SUPERSET_PASSWORD=change-me
CLICKHOUSE_OPS_PASSWORD=change-me
# Host processes (downloader, chunker, tests) write run metrics here
CLICKHOUSE_URL=http://localhost:28123

# Postgres (metadata for SQLMesh state, Prefect, Superset; one DB + role each)
POSTGRES_PORT=25432
POSTGRES_PASSWORD=change-me
SQLMESH_DB_PASSWORD=change-me
PREFECT_DB_PASSWORD=change-me
SUPERSET_DB_PASSWORD=change-me

# Prefect server (UI + API). Host processes use PREFECT_API_URL.
PREFECT_PORT=24200
PREFECT_API_URL=http://localhost:24200/api

# Superset
SUPERSET_PORT=28088
SUPERSET_SECRET_KEY=change-me
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change-me

# Alerts
SLACK_WEBHOOK_URL=
